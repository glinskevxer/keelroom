{
  "name": "keelroom",
  "version": "0.1.0",
  "private": true,
  "description": "Pilotage dispatch, transit planning and settlement for a compulsory pilotage district",
  "license": "UNLICENSED",
  "author": "glinskevxer <roym78109@gmail.com>",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "bin": {
    "keelroom": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "verify-tree": "tsx scripts/verify-tree.ts",
    "check": "bash scripts/check.sh",
    "version:write": "tsx scripts/build-version.ts",
    "version:check": "tsx scripts/build-version.ts --check",
    "commands": "tsx scripts/build-command-reference.ts",
    "commands:check": "tsx scripts/build-command-reference.ts --check",
    "release-check": "tsx scripts/release-check.ts",
    "export-check": "bash scripts/export-check.sh",
    "audit": "npm audit --omit=dev --json > audit.json || true && tsx scripts/audit-dependencies.ts --from-audit audit.json"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "commander": "13.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "20.17.24",
    "@vitest/coverage-v8": "3.0.8",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.2",
    "prettier": "3.5.2",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.0",
    "vitest": "3.0.8"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
